{
  "vim.leader": "<Space>",
  "vim.useSystemClipboard": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.useCtrlKeys": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "f",
        "f"
      ],
      "commands": [
        "editor.action.formatDocument"
      ],
      "when": "editorHasFocus"
    }
  ],
  "vim.handleKeys": {
    "<C-b>": false,
    "<C-j>": false,
    "<C-f>": false,
    "<C-p>": false,
    "<C-space>": false
  },
  "editor.formatOnSave": true
}
